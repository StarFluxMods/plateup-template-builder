# =============================================================================
# Unity project
# =============================================================================

# Generated folders
/UnityProject - MyMod/[Ll]ibrary/
/UnityProject - MyMod/[Tt]emp/
/UnityProject - MyMod/[Oo]bj/
/UnityProject - MyMod/[Bb]uild/
/UnityProject - MyMod/[Bb]uilds/
/UnityProject - MyMod/[Ll]ogs/
/UnityProject - MyMod/[Uu]ser[Ss]ettings/

# Memory captures and recordings can be large and may contain sensitive data
/UnityProject - MyMod/[Mm]emoryCaptures/
/UnityProject - MyMod/[Rr]ecordings/

# Autogenerated JetBrains Rider plugin
/UnityProject - MyMod/[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle cache
/UnityProject - MyMod/.gradle/

# Autogenerated IDE solution and project files
/UnityProject - MyMod/ExportedObj/
/UnityProject - MyMod/.consulo/
/UnityProject - MyMod/**/*.csproj
/UnityProject - MyMod/**/*.unityproj
/UnityProject - MyMod/**/*.sln
/UnityProject - MyMod/**/*.userprefs
/UnityProject - MyMod/**/*.pidb
/UnityProject - MyMod/**/*.booproj
/UnityProject - MyMod/**/*.svd
/UnityProject - MyMod/**/*.mdb
/UnityProject - MyMod/**/*.opendb
/UnityProject - MyMod/**/*.VC.db

# Meta files generated for ignored files
/UnityProject - MyMod/**/*.pidb.meta
/UnityProject - MyMod/**/*.pdb.meta
/UnityProject - MyMod/**/*.mdb.meta

# Crash reports
/UnityProject - MyMod/**/sysinfo.txt
/UnityProject - MyMod/**/crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Packed Addressables
/UnityProject - MyMod/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/UnityProject - MyMod/[Aa]ssets/[Ss]treamingAssets/aa.meta
/UnityProject - MyMod/[Aa]ssets/[Ss]treamingAssets/aa/*

# Blender backup files (and the meta files Unity creates for them)
*.blend1
*.blend1.meta

# =============================================================================
# OS junk
# =============================================================================

.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
